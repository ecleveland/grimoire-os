datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// ── Enums ──────────────────────────────────────────────

enum Role {
  player
  dungeon_master
  admin
}

enum CampaignStatus {
  active
  paused
  completed
  archived
}

enum NoteVisibility {
  private
  party
  dm_only
}

enum AuditAction {
  create
  update
  delete
}

// Origin (and visibility tier) of a piece of reference content
// (monsters/spells/feats/magic items), all living in the same tables:
//   srd      — loaded by the seed; globally visible; immutable.
//   shared   — admin-published; globally visible like SRD; editable by any admin.
//   homebrew — user-authored; visible only to its creator.
// The "global catalog" everyone sees is srd + shared (VEG-292, VEG-310).
enum ContentSource {
  srd
  shared
  homebrew
}

// ── Users ──────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  username            String    @unique
  passwordHash        String
  displayName         String
  email               String?   @unique
  avatarUrl           String?
  role                Role      @default(player)
  failedLoginAttempts Int       @default(0)
  lockoutUntil        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  ownedCampaigns            Campaign[]             @relation("CampaignOwner")
  campaigns                 CampaignPlayer[]
  characters                Character[]
  notes                     Note[]
  encounters                Encounter[]
  npcs                      Npc[]
  shops                     Shop[]
  addedNpcCustomPersonality NpcCustomPersonality[]
  refreshTokens             RefreshToken[]
  homebrewMonsters          Monster[]
  homebrewSpells            Spell[]
  homebrewItems             Item[]
  homebrewFeats             Feat[]

  @@map("users")
}

// ── Refresh Tokens ─────────────────────────────────────

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @unique
  createdAt    DateTime  @default(now())

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id])
  replaces   RefreshToken? @relation("RefreshTokenRotation")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ── Campaigns ──────────────────────────────────────────

model Campaign {
  id                  String         @id @default(uuid())
  name                String
  description         String?
  ownerId             String
  status              CampaignStatus @default(active)
  setting             String?
  currentSession      Int            @default(0)
  inviteCode          String?        @unique
  inviteCodeExpiresAt DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  owner      User             @relation("CampaignOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  players    CampaignPlayer[]
  characters Character[]
  notes      Note[]
  encounters Encounter[]
  npcs       Npc[]
  shops      Shop[]

  @@index([ownerId])
  @@map("campaigns")
}

model CampaignPlayer {
  campaignId String
  userId     String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([campaignId, userId])
  @@map("campaign_players")
}

// ── Characters ─────────────────────────────────────────

model Character {
  id                  String   @id @default(uuid())
  name                String
  userId              String
  campaignId          String?
  race                String?
  class               String?
  level               Int      @default(1)
  subclass            String?
  background          String?
  alignment           String?
  experiencePoints    Int      @default(0)
  abilityScores       Json?
  hitPoints           Json?
  deathSaves          Json?
  armorClass          Int?
  speed               Int?
  initiative          Int?
  proficiencies       String[]
  languages           String[]
  savingThrows        String[]
  skills              String[]
  spellcastingAbility String?
  spellSaveDC         Int?
  spellAttackBonus    Int?
  spells              Json?
  spellSlots          Json?
  inventory           Json?
  attunedItems        Json?
  currency            Json?
  features            Json?
  feats               Json?
  personalityTraits   String?
  ideals              String?
  bonds               String?
  flaws               String?
  backstory           String?
  appearance          String?
  avatarUrl           String?
  size                String?
  heroicInspiration   Boolean  @default(false)
  hitDice             Json?
  armorTraining       String[]
  weapons             Json?
  // PC status tracking (VEG-408): SRD conditions, concentration, exhaustion 1–6.
  conditions          String[]
  concentration       Json?
  exhaustion          Int?
  // Limited-use class/race resources (VEG-409): [{ name, max, used, recharge }].
  resources           Json?
  // Optimistic-locking counter (VEG-137); guarded updates increment it.
  version             Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@index([userId])
  @@index([campaignId])
  @@map("characters")
}

// ── Notes ──────────────────────────────────────────────

model Note {
  id            String         @id @default(uuid())
  title         String
  content       String?
  campaignId    String
  authorId      String
  visibility    NoteVisibility @default(private)
  sessionNumber Int?
  tags          String[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([authorId])
  @@map("notes")
}

// ── Encounters ─────────────────────────────────────────

model Encounter {
  id          String   @id @default(uuid())
  name        String
  campaignId  String
  createdById String
  combatants  Json?
  currentTurn Int      @default(0)
  round       Int      @default(1)
  isActive    Boolean  @default(false)
  // Optimistic-locking counter (VEG-137); guarded updates increment it.
  version     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign  Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([createdById])
  @@map("encounters")
}

// ── SRD Data ───────────────────────────────────────────

model Spell {
  id            String        @id @default(uuid())
  name          String
  level         Int
  school        String
  castingTime   String
  range         String
  components    String
  duration      String
  description   String
  classes       String[]
  ritual        Boolean       @default(false)
  concentration Boolean       @default(false)
  material      String?
  higherLevels  String?
  source        String        @default("SRD 5.2.1")
  contentSource ContentSource @default(srd)
  createdById   String?
  campaignId    String?

  // SetNull (not Cascade): admin-published `shared` rows are global catalog
  // content and must survive their author's deletion. Homebrew rows are
  // deleted at the service layer (UsersService.remove) and backstopped by a
  // hand-authored DB CHECK: homebrew must always have a creator (VEG-317).
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  // SRD-name uniqueness and per-user homebrew-name uniqueness are enforced by
  // partial unique indexes added by hand in the migration (Prisma cannot model
  // partial indexes). See the add_homebrew_content_source migration.
  @@index([level])
  @@index([school])
  @@index([contentSource])
  @@index([createdById])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "spells_name_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "spells_description_trgm_idx")
  @@map("spells")
}

model Monster {
  id                    String        @id @default(uuid())
  name                  String
  size                  String
  type                  String
  subtype               String?
  alignment             String?
  armorClass            Int
  armorType             String?
  hitPoints             Int
  hitDice               String?
  speed                 String
  str                   Int
  dex                   Int
  con                   Int
  int                   Int
  wis                   Int
  cha                   Int
  savingThrows          Json?
  skills                Json?
  damageResistances     String[]
  damageImmunities      String[]
  damageVulnerabilities String[]
  conditionImmunities   String[]
  senses                String?
  languages             String?
  challengeRating       Float
  experiencePoints      Int?
  specialAbilities      Json?
  actions               Json?
  reactions             Json?
  legendaryActions      Json?
  description           String?
  source                String        @default("SRD 5.2.1")
  contentSource         ContentSource @default(srd)
  createdById           String?
  campaignId            String?

  // SetNull (not Cascade): admin-published `shared` rows are global catalog
  // content and must survive their author's deletion. Homebrew rows are
  // deleted at the service layer (UsersService.remove) and backstopped by a
  // hand-authored DB CHECK: homebrew must always have a creator (VEG-317).
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  // Name uniqueness is enforced by partial unique indexes (per-source) added by
  // hand in the add_homebrew_content_source migration; Prisma cannot model them.
  @@index([type])
  @@index([challengeRating])
  @@index([contentSource])
  @@index([createdById])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "monsters_name_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "monsters_description_trgm_idx")
  @@map("monsters")
}

model Item {
  id                  String        @id @default(uuid())
  name                String
  category            String
  cost                String?
  weight              Float?
  description         String?
  damage              String?
  damageType          String?
  // Wearable-armor AC is self-describing text ("11 + Dex modifier",
  // "13 + Dex modifier (max 2)", "16", "+2"). Creature AC elsewhere
  // (monsters/characters/NPCs) remains Int — only the item field is a string.
  armorClass          String?
  stealthDisadvantage Boolean       @default(false)
  strengthRequirement Int?
  properties          String[]
  rarity              String?
  requiresAttunement  Boolean       @default(false)
  isMagic             Boolean       @default(false)
  source              String        @default("SRD 5.2.1")
  contentSource       ContentSource @default(srd)
  createdById         String?
  campaignId          String?

  // SetNull (not Cascade): admin-published `shared` rows are global catalog
  // content and must survive their author's deletion. Homebrew rows are
  // deleted at the service layer (UsersService.remove) and backstopped by a
  // hand-authored DB CHECK: homebrew must always have a creator (VEG-317).
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  // Equipment packs (category "Equipment Pack") map to their component items
  // through ItemBundleEntry (VEG-308).
  bundleContents ItemBundleEntry[] @relation("BundleContents")
  containedIn    ItemBundleEntry[] @relation("BundleComponent")

  // Name uniqueness is enforced by partial unique indexes (per-source) added by
  // hand in the add_homebrew_content_source migration; Prisma cannot model them.
  @@index([category])
  @@index([contentSource])
  @@index([createdById])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "items_name_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "items_description_trgm_idx")
  @@map("items")
}

// A bundle item's (equipment pack's) component line: bundle → component with a
// quantity (e.g. Burglar's Pack → 10× Candle). Self-referential through Item so
// pack contents resolve to real catalog rows (VEG-308). Cascade on both sides:
// an entry is meaningless without either endpoint — note the component-side
// cascade silently shrinks packs if component items ever become user-deletable.
// Hand-authored CHECKs in the migration (Prisma cannot model them) enforce
// quantity >= 1 and bundleId <> componentId beyond the seed-time validator.
model ItemBundleEntry {
  id          String @id @default(uuid())
  bundleId    String
  componentId String
  quantity    Int    @default(1)

  bundle    Item @relation("BundleContents", fields: [bundleId], references: [id], onDelete: Cascade)
  component Item @relation("BundleComponent", fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([bundleId, componentId])
  @@index([componentId])
  @@map("item_bundle_entries")
}

model SrdClass {
  id                  String   @id @default(uuid())
  name                String   @unique
  hitDie              String
  primaryAbilities    String[]
  savingThrows        String[]
  armorProficiencies  String[]
  weaponProficiencies String[]
  skillChoices        String[]
  toolProficiencies   String[]
  numSkillChoices     Int      @default(2)
  description         String?
  spellcasting        Json?
  equipmentChoices    Json?
  multiclassing       Json?
  subclassLevel       Int?
  source              String   @default("SRD 5.2.1")

  subclasses Subclass[]
  features   ClassFeature[]

  @@map("srd_classes")
}

model Race {
  id              String   @id @default(uuid())
  name            String   @unique
  speed           Int
  size            String
  abilityBonuses  Json?
  languages       String[]
  description     String?
  age             String?
  alignment       String?
  sizeDescription String?
  source          String   @default("SRD 5.2.1")

  subraces Subrace[]
  traits   RaceTrait[]

  @@map("races")
}

model Subclass {
  id           String  @id @default(uuid())
  name         String  @unique
  classId      String
  description  String?
  spellList    Json?
  spellcasting Json?
  source       String  @default("SRD 5.2.1")

  srdClass SrdClass          @relation(fields: [classId], references: [id])
  features SubclassFeature[]

  @@map("subclasses")
}

model Subrace {
  id             String  @id @default(uuid())
  name           String  @unique
  raceId         String
  description    String?
  abilityBonuses Json?
  traits         Json?
  source         String  @default("SRD 5.2.1")

  race Race @relation(fields: [raceId], references: [id])

  @@map("subraces")
}

model Background {
  id                 String   @id @default(uuid())
  name               String   @unique
  description        String?
  skillProficiencies String[]
  toolProficiencies  String[]
  languages          Int      @default(0)
  equipment          String?
  personalityTraits  String[]
  ideals             String[]
  bonds              String[]
  flaws              String[]
  source             String   @default("SRD 5.2.1")

  // Canonical SRD origin feat (VEG-429). The option captures the chosen
  // parameter for repeatable feats (e.g. Magic Initiate "Cleric"); null for
  // non-parameterized feats. SetNull so deleting a feat row never deletes the
  // background — it just unlinks.
  originFeatId     String?
  originFeatOption String?
  originFeat       Feat?   @relation("BackgroundOriginFeat", fields: [originFeatId], references: [id], onDelete: SetNull)

  features BackgroundFeature[]

  @@index([originFeatId])
  @@map("backgrounds")
}

model ClassFeature {
  id          String @id @default(uuid())
  name        String
  level       Int
  description String
  classId     String

  class SrdClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, name])
  @@index([name])
  @@index([classId])
  @@map("class_features")
}

model SubclassFeature {
  id          String @id @default(uuid())
  name        String
  level       Int
  description String
  subclassId  String

  subclass Subclass @relation(fields: [subclassId], references: [id], onDelete: Cascade)

  @@unique([subclassId, name])
  @@index([name])
  @@index([subclassId])
  @@map("subclass_features")
}

model RaceTrait {
  id          String @id @default(uuid())
  name        String
  description String
  raceId      String

  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@unique([raceId, name])
  @@index([name])
  @@index([raceId])
  @@map("race_traits")
}

model BackgroundFeature {
  id           String @id @default(uuid())
  name         String
  description  String
  backgroundId String

  background Background @relation(fields: [backgroundId], references: [id], onDelete: Cascade)

  @@unique([backgroundId, name])
  @@index([name])
  @@index([backgroundId])
  @@map("background_features")
}

model Feat {
  id            String        @id @default(uuid())
  name          String
  description   String?
  prerequisite  String?
  benefits      Json?
  category      String?
  repeatable    Boolean       @default(false)
  source        String        @default("SRD 5.2.1")
  contentSource ContentSource @default(srd)
  createdById   String?
  campaignId    String?

  // SetNull (not Cascade): admin-published `shared` rows are global catalog
  // content and must survive their author's deletion. Homebrew rows are
  // deleted at the service layer (UsersService.remove) and backstopped by a
  // hand-authored DB CHECK: homebrew must always have a creator (VEG-317).
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  // Backgrounds whose canonical origin feat is this row (VEG-429).
  originForBackgrounds Background[] @relation("BackgroundOriginFeat")

  // Name uniqueness is enforced by partial unique indexes (per-source) added by
  // hand in the add_homebrew_content_source migration; Prisma cannot model them.
  @@index([contentSource])
  @@index([createdById])
  @@map("feats")
}

model Condition {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  bullets     String[]
  source      String   @default("SRD 5.2.1")

  @@map("conditions")
}

model Skill {
  id          String  @id @default(uuid())
  name        String  @unique
  ability     String
  description String?
  source      String  @default("SRD 5.2.1")

  @@map("skills")
}

model Language {
  id              String  @id @default(uuid())
  name            String  @unique
  type            String
  typicalSpeakers String?
  script          String?
  source          String  @default("SRD 5.2.1")

  @@map("languages")
}

// ── Game Rules (reference data) ───────────────────────

model GameRule {
  id       String @id @default(uuid())
  category String
  key      String
  value    Json
  source   String @default("SRD 5.2.1")

  @@unique([category, key])
  @@map("game_rules")
}

// ── NPC Generator ─────────────────────────────────────

model Npc {
  id          String @id @default(uuid())
  campaignId  String
  createdById String

  // Identity
  name       String
  race       String
  background String?
  profession String?
  alignment  String?
  size       String?
  age        Int?
  gender     String?

  // Description
  appearance        String?
  personalityTraits String[] @default([])
  ideals            String[] @default([])
  bonds             String[] @default([])
  flaws             String[] @default([])

  // Combat (null = Lite mode, default)
  statBlock Json?

  // Coinage — scaled to profession/background, not a flat gp value
  goldPieces   Int @default(0)
  silverPieces Int @default(0)
  copperPieces Int @default(0)

  // Loot
  loot          Json?
  lootOverrides Json?

  // Generation metadata
  generationParams Json?
  lockedFields     String[] @default([])
  isManual         Boolean  @default(false)

  campaign      Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy     User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  outgoingLinks NpcRelation[] @relation("FromNpc")
  incomingLinks NpcRelation[] @relation("ToNpc")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([createdById])
  @@map("npcs")
}

// ── Campaign Shops ────────────────────────────────────

model Shop {
  id          String @id @default(uuid())
  campaignId  String
  createdById String

  name        String
  theme       String
  description String?

  // Optional theming (icon key, accent colour) for the storefront card
  icon   String?
  accent String?

  // ShopLineItem[] — denormalized stock lines with structured coin prices
  items Json?

  // Hide a shop from players without deleting it
  isOpen Boolean @default(true)

  // Optimistic-locking counter (VEG-137 pattern); a guarded purchase decrements
  // stock and increments this so concurrent buys can't oversell (VEG-357).
  version Int @default(0)

  campaign  Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([createdById])
  @@map("shops")
}

model NpcRelation {
  id        String  @id @default(uuid())
  fromNpcId String
  toNpcId   String
  relation  String
  notes     String?

  fromNpc Npc @relation("FromNpc", fields: [fromNpcId], references: [id], onDelete: Cascade)
  toNpc   Npc @relation("ToNpc", fields: [toNpcId], references: [id], onDelete: Cascade)

  @@unique([fromNpcId, toNpcId, relation])
  @@map("npc_relations")
}

// ── NPC Generator reference data ──────────────────────

model NpcNamePool {
  id       String  @id @default(uuid())
  race     String
  gender   String?
  kind     String
  value    String
  source   String  @default("curated")
  isActive Boolean @default(true)

  @@index([race, kind])
  @@map("npc_name_pools")
}

model NpcAppearanceTrait {
  id       String  @id @default(uuid())
  race     String
  category String
  trait    String
  source   String  @default("curated")
  isActive Boolean @default(true)

  @@index([race, category])
  @@map("npc_appearance_traits")
}

// Discriminates loot-template families sharing npc_loot_templates: 'npc' rows
// are keyed by profession, 'monster' rows by normalized creature type
// (VEG-298). The `profession` column holds the selection key for both.
enum LootTemplateCategory {
  npc
  monster
}

model NpcLootTemplate {
  id         String               @id @default(uuid())
  category   LootTemplateCategory @default(npc)
  profession String
  crBucket   String
  coinage    Json
  items      Json
  source     String               @default("curated")
  isActive   Boolean              @default(true)

  @@index([category, profession, crBucket])
  @@map("npc_loot_templates")
}

model NpcAlignmentPrior {
  id         String  @id @default(uuid())
  race       String
  background String?
  weights    Int[]
  source     String  @default("curated")
  isActive   Boolean @default(true)

  @@unique([race, background])
  @@map("npc_alignment_priors")
}

model Trinket {
  id          String  @id @default(uuid())
  description String
  source      String  @default("curated")
  isActive    Boolean @default(true)

  @@map("trinkets")
}

model NpcCustomPersonality {
  id         String   @id @default(uuid())
  background String
  kind       String
  value      String
  addedById  String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  addedBy User? @relation(fields: [addedById], references: [id], onDelete: SetNull)

  @@index([background, kind])
  @@index([addedById])
  @@map("npc_custom_personality")
}

// ── Audit Log ─────────────────────────────────────────

model AuditLog {
  id        String      @id @default(uuid())
  userId    String
  username  String
  action    AuditAction
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
