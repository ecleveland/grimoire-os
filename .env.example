# PostgreSQL
DATABASE_URL=postgresql://grimoire:grimoire@localhost:5432/grimoire_os

# Auth (JWT_SECRET is required — the backend will not start without it)
JWT_SECRET=               # Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_EXPIRES_IN=24h

# CORS
FRONTEND_URL=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Server-side API URL for SSR data fetches (the SRD reference pages). Only needed
# when the frontend's server process can't reach the backend at
# NEXT_PUBLIC_API_URL — e.g. in Docker, where it is http://backend:3001/api.
# Falls back to NEXT_PUBLIC_API_URL for local dev (both on the host's localhost).
# INTERNAL_API_URL=http://backend:3001/api

# Rate limiting (per-minute token-bucket window, applied per user id when
# authenticated and per IP otherwise). Defaults are conservative.
# THROTTLE_TTL_MS=60000
# THROTTLE_ANON_LIMIT=30
# THROTTLE_AUTHED_LIMIT=120
