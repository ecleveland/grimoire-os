# PostgreSQL container. Compose requires POSTGRES_PASSWORD and refuses to start
# without it. grimoire is the dev value, so change it for any real deployment.
# Keep it URL-safe, because compose places it inside the backend's DATABASE_URL.
# Generate one with openssl rand -hex 32. Base64 output can contain /, which
# breaks the database URL and stops the backend from booting.
# Postgres applies it only when it creates the data volume. An older volume keeps
# grimoire, so see "Upgrading an existing install" in README.md before changing it.
POSTGRES_PASSWORD=grimoire
# POSTGRES_USER=grimoire
# POSTGRES_DB=grimoire_os

# Database URL for the backend that dev.sh runs on the host. The compose stack
# ignores it and builds its own from the POSTGRES_* values above.
DATABASE_URL=postgresql://grimoire:grimoire@localhost:5432/grimoire_os

# Auth (JWT_SECRET is required — the backend will not start without it)
JWT_SECRET=               # Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_EXPIRES_IN=24h

# Auth cookie Secure flag: true, false or unset. Unset, the flag follows
# NODE_ENV=production, which the backend Docker image sets. Leave it unset behind
# TLS. Set false to serve over plain HTTP on a trusted network. Browsers drop a
# Secure cookie sent over HTTP, so login would fail with no message. The backend logs
# the mode in force at startup.
# COOKIE_SECURE=false

# The address users open in the browser, for example the URL a reverse proxy
# serves. The compose stack uses it as the backend's CORS origin, and it
# defaults to http://localhost:3000. dev.sh reads FRONTEND_URL below instead.
# PUBLIC_URL=https://grimoire.example.com

# The host address the compose stack publishes port 3000 on. The default
# 127.0.0.1 admits only a reverse proxy on the same host. 0.0.0.0 opens the
# port to the network, where clients can forge X-Forwarded-For.
# FRONTEND_BIND=0.0.0.0

# How many proxy hops the backend trusts for the client address in
# X-Forwarded-For, which the rate limits key on. The compose stack sets 1,
# because the frontend container proxies every API call. Unset means 0, as in
# dev.sh, where the browser calls the backend directly. Under compose, 0 puts
# every client in one rate-limit bucket.
# TRUST_PROXY=1

# Backend log level: error, warn, log, debug or verbose. Unset means log, which prints a line per request.
# LOG_LEVEL=log
# Backend log format: text or json. Unset means text, and json prints one JSON object per line.
# LOG_FORMAT=json

# CORS origin for the backend that dev.sh runs.
FRONTEND_URL=http://localhost:3000

# Frontend. Without it the browser calls the relative /api, and the Next server
# proxies those calls to the backend. dev.sh sets it so the browser calls the
# backend on port 3001 directly. Next reads it when it builds the frontend.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# The backend address the Next server uses for SSR data fetches and for the /api
# proxy. In Docker it is http://backend:3001/api, which compose sets. Unset, it
# falls back to NEXT_PUBLIC_API_URL when that is an absolute URL, then to
# http://localhost:3001/api for local dev.
# INTERNAL_API_URL=http://backend:3001/api

# Rate limiting (per-minute token-bucket window, applied per user id when
# authenticated and per IP otherwise). Defaults are conservative.
# THROTTLE_TTL_MS=60000
# THROTTLE_ANON_LIMIT=30
# THROTTLE_AUTHED_LIMIT=120
